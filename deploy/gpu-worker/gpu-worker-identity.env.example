# Copy this file to:
#   ~/.config/robotswarm/gpu-worker-identity.env
#
# Replace every placeholder locally, then set mode 0600. Never commit the
# enrolled worker secret.

Worker__BackendUrl="https://robot.zerav.la"
Worker__WorkerId="00000000-0000-0000-0000-000000000000"
Worker__WorkerSecret="replace-with-the-enrollment-secret"
Worker__Name="gpu-worker-01"
Worker__MaxConcurrentSessions="4"
Worker__MaxRobotsPerSession="10"

# Keep disabled until the shipped protocol-2 helper has passed the full host
# media smoke test. Once enabled, deployment requires this RTSP endpoint and
# verifies host Gazebo 11, Xvfb/XTest, the H.264 encoder, render plugin and
# versioned visual assets. gzclient runs in WSL, never in a sidecar container.
Worker__Viewer__Enabled="false"
Worker__Viewer__PublishBaseUrl=""
# Xvfb uses its cookie-authenticated Linux abstract Unix endpoint. WSLg's
# read-only /tmp/.X11-unix filesystem mount may produce a harmless warning,
# but `-nolisten tcp` ensures no X11 port is exposed to the host network.
ROBOTSWARM_VIEWER_DISPLAY_TRANSPORT="unix"
ROBOTSWARM_VIEWER_ENCODER="auto"
# The versioned GUI plugin applies this cap to Gazebo's active user camera.
ROBOTSWARM_VIEWER_RENDER_RATE="50"
# READY requires both measured camera and post-render rates to stay at least
# this high during the GUI probe's sample window.
ROBOTSWARM_VIEWER_MIN_RENDER_RATE="45"
# Mesa D3D12 adapter selection used by WSL's host gzclient.
ROBOTSWARM_VIEWER_GPU_ADAPTER_NAME="NVIDIA"
