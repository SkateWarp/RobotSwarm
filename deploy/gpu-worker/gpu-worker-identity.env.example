# Copy this file to:
#   ~/.config/robotswarm/gpu-worker-identity.env
#
# Replace every placeholder locally, then set mode 0600. Never commit the
# enrolled worker secret.

Worker__BackendUrl="https://robot.zerav.la"
Worker__WorkerId="00000000-0000-0000-0000-000000000000"
Worker__WorkerSecret="replace-with-the-enrollment-secret"
Worker__Name="gpu-worker-01"
Worker__MaxConcurrentSessions="4"
Worker__MaxRobotsPerSession="10"

