# Copy this file to:
#   ~/.config/robotswarm/gpu-worker-identity.env
#
# Replace every placeholder locally, then set mode 0600. Never commit the
# enrolled worker secret.

Worker__BackendUrl="https://robot.zerav.la"
Worker__WorkerId="00000000-0000-0000-0000-000000000000"
Worker__WorkerSecret="replace-with-the-enrollment-secret"
Worker__Name="gpu-worker-01"
Worker__MaxConcurrentSessions="4"
Worker__MaxRobotsPerSession="10"

# Keep disabled until the shipped protocol-1 helper has passed the full host
# media smoke test. Once enabled, deployment requires this RTSP endpoint,
# verifies an H.264 encoder, and exposes only the authenticated private display
# to Docker. The absolute helper path still comes from the versioned release.
Worker__Viewer__Enabled="false"
Worker__Viewer__PublishBaseUrl=""
# WSLg makes /tmp/.X11-unix read-only, so use authenticated X11 over TCP.
ROBOTSWARM_VIEWER_DISPLAY_TRANSPORT="tcp"
ROBOTSWARM_VIEWER_ENCODER="auto"
