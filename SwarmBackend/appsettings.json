{
  "AppSettings": {
    "Secret": "",
    "Issuer": "https://robot.zerav.la",
    "ExpiresIn": 20,
    "RefreshTokenExpiresInDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Accounts": {
    "PublicRegistrationEnabled": false
  },
  "RateLimits": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Registration": {
      "PermitLimit": 3,
      "WindowMinutes": 60
    },
    "SessionCreation": {
      "PermitLimit": 6,
      "WindowSeconds": 60
    },
    "ViewerHls": {
      "TokenLimit": 120,
      "TokensPerSecond": 60
    }
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "LegacyControl": {
    "Enabled": false
  },
  "Viewer": {
    "PublicBaseUrl": "",
    "WorkerPublishingEnabled": false,
    "HlsProxyEnabled": false,
    "HlsPublicBaseUrl": "",
    "HlsOriginBaseUrl": "http://media:8888",
    "HlsCdnSecret": "",
    "HlsUpstreamTimeoutSeconds": 15
  },
  "BootstrapAdmin": {
    "Email": "",
    "Password": ""
  },
  "Workers": {
    "OrphanAfterSeconds": 90
  },
  "Tasks": {
    "RequireCollaborativeTransportEvidence": false,
    "MonitorIntervalSeconds": 5,
    "QueuedTimeoutSeconds": 120,
    "AcceptedTimeoutSeconds": 90,
    "ProgressTimeoutSeconds": 300
  },
  "Sessions": {
    "MaxRobotsPerSession": 10,
    "MaxQueuedSessions": 25,
    "QueueTtlMinutes": 30,
    "SessionTtlMinutes": 180
  },
  "ConnectionStrings": {
    "Default": "User Id=${DB_USER};Password=${DB_PASSWORD};Server=db;Port=5432;Database=${DB_NAME}"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:44336"
      }
    }
  }
}
