{
  "AppSettings": {
    "Secret": "",
    "Issuer": "https://robot.zerav.la",
    "ExpiresIn": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LegacyControl": {
    "Enabled": false
  },
  "Viewer": {
    "PublicBaseUrl": "",
    "WorkerPublishingEnabled": false
  },
  "BootstrapAdmin": {
    "Email": "",
    "Password": ""
  },
  "Workers": {
    "OrphanAfterSeconds": 90
  },
  "Sessions": {
    "MaxRobotsPerSession": 10
  },
  "ConnectionStrings": {
    "Default": "User Id=${DB_USER};Password=${DB_PASSWORD};Server=db;Port=5432;Database=${DB_NAME}"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:44336"
      }
    }
  }
}
