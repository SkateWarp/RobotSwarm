DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=swarm

# Generate a production value with: openssl rand -base64 48
AppSettings__Secret=
AppSettings__Issuer=https://robot.zerav.la

Cors__Origins__0=https://rs.zerav.la
REACT_APP_API_URL=https://robot.zerav.la
# Bind the backend to the LAN address used by Nginx Proxy Manager.
BACKEND_PUBLISH_IP=10.0.0.126
# Public self-registration is intentionally off. Admins can still create users.
Accounts__PublicRegistrationEnabled=false
RateLimits__Authentication__PermitLimit=10
RateLimits__Authentication__WindowSeconds=60
RateLimits__Registration__PermitLimit=3
RateLimits__Registration__WindowMinutes=60
RateLimits__SessionCreation__PermitLimit=6
RateLimits__SessionCreation__WindowSeconds=60
RateLimits__ViewerHls__TokenLimit=120
RateLimits__ViewerHls__TokensPerSecond=60
# Loopback Nginx Proxy Manager is trusted automatically. If NPM reaches the
# backend from another local address, put that exact proxy address here.
ReverseProxy__KnownProxies__0=
# Set this only after a separate public MediaMTX WHEP/ICE route is accepted.
# The commissioned HLS path below does not need another hostname.
Viewer__PublicBaseUrl=
# Keep false until the GPU worker has a verified WebRTC publisher.
Viewer__WorkerPublishingEnabled=false
# Low-latency HLS uses the existing backend hostname and stays disabled until
# one real session passes the authenticated publisher/viewer acceptance test.
Viewer__HlsProxyEnabled=false
Viewer__HlsPublicBaseUrl=https://robot.zerav.la/api/viewer/hls
Viewer__HlsUpstreamTimeoutSeconds=15
# Separate internal credential used only between the backend proxy and
# MediaMTX. Generate a base64url value with at least 43 characters.
MEDIA_HLS_CDN_SECRET=

# Optional one-time bootstrap. Remove both secrets after the first admin exists.
BootstrapAdmin__Email=
BootstrapAdmin__Password=
Workers__OrphanAfterSeconds=90
# Enable only after the matching GPU worker advertises transport evidence v1.
Tasks__RequireCollaborativeTransportEvidence=false
Sessions__MaxRobotsPerSession=10
Sessions__MaxQueuedSessions=25
Sessions__QueueTtlMinutes=30
Sessions__SessionTtlMinutes=180

# Bind RTSP only to the LAN address used by the GPU worker.
MEDIA_PUBLISH_IP=10.0.0.126
# Leave loopback until a public UDP address or TURN server is configured.
MEDIA_WEBRTC_IP=127.0.0.1
