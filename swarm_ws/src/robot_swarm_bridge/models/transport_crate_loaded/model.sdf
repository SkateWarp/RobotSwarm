<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    This is an acceptance-test payload, not the fast practice crate embedded
    in swarm_arena.world.  A Burger weighs about 1 kg and its stock Gazebo
    wheel contact coefficient is 0.1.  The crate's nominal breakaway force is
    therefore above one robot's available traction and below the combined
    traction of four robots:

      crate:  0.75 kg * 0.25 * g = 1.84 N
      Burger: 1.00 kg * 0.10 * g = 0.98 N each

    The live load probe verifies the actual simulator response; these numbers
    are only the physical bracket used to choose a sensible starting profile.
  -->
  <model name="transport_object">
    <link name="link">
      <velocity_decay>
        <linear>0.002</linear>
        <angular>0.005</angular>
      </velocity_decay>
      <inertial>
        <mass>0.75</mass>
        <inertia>
          <ixx>0.0125</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0125</iyy><iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.4 0.4 0.2</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.25</mu>
              <mu2>0.25</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <max_vel>0.02</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.4 0.4 0.2</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.48 0.08 1</ambient>
          <diffuse>0.95 0.56 0.10 1</diffuse>
        </material>
      </visual>
    </link>
    <pose>0 0 0.1 0 0 0</pose>
  </model>
</sdf>
