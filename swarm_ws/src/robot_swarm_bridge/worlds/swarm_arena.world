<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="swarm_arena">

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <!-- 1000 updates/s * 3 ms/step gives a 3.0 target RTF. -->
      <max_step_size>0.003</max_step_size>
      <real_time_factor>3.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <!-- A 1.0 global ceiling also limits Burger wheel joints to about
               1 rad/s in Gazebo Classic. Ten keeps commanded wheel speeds
               accurate; the payload keeps its own 0.1 contact cap below. -->
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ==================== ARENA FLOOR (visual reference) ==================== -->
    <model name="arena_floor">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.80 1</ambient>
            <diffuse>0.85 0.85 0.80 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 0.001 0 0 0</pose>
    </model>

    <!-- ==================== ARENA BOUNDARY WALLS ==================== -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 5.05 0.25 0 0 0</pose>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 -5.05 0.25 0 0 0</pose>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 10.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 10.0 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>5.05 0 0.25 0 0 0</pose>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 10.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 10.0 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.05 0 0.25 0 0 0</pose>
    </model>

    <!-- ==================== STATIC OBSTACLES ==================== -->

    <!-- Box obstacle 1 (top-left area) -->
    <model name="obstacle_box_1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-3.0 3.0 0.2 0 0 0</pose>
    </model>

    <!-- Box obstacle 2 (center-right) -->
    <model name="obstacle_box_2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>2.5 0.5 0.2 0 0 0.3</pose>
    </model>

    <!-- Box obstacle 3 (bottom-right) -->
    <model name="obstacle_box_3">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.3 0.1 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>3.5 -3.0 0.2 0 0 0</pose>
    </model>

    <!-- Cylinder obstacle 1 (top-right) -->
    <model name="obstacle_cyl_1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>3.0 2.5 0.2 0 0 0</pose>
    </model>

    <!-- Cylinder obstacle 2 (center-left) -->
    <model name="obstacle_cyl_2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-2.0 -1.5 0.2 0 0 0</pose>
    </model>

    <!-- Cylinder obstacle 3 (bottom-center) -->
    <model name="obstacle_cyl_3">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0.5 -3.5 0.2 0 0 0</pose>
    </model>

    <!-- Wall obstacle 1 (L-shaped barrier, horizontal part) -->
    <model name="obstacle_wall_1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.1 0.4</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.2 1</ambient>
            <diffuse>0.6 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-1.0 1.5 0.2 0 0 0</pose>
    </model>

    <!-- Wall obstacle 2 (L-shaped barrier, vertical part) -->
    <model name="obstacle_wall_2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 1.2 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.2 0.4</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.2 1</ambient>
            <diffuse>0.6 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-0.25 2.05 0.2 0 0 0</pose>
    </model>

    <!-- Wall obstacle 3 (diagonal barrier) -->
    <model name="obstacle_wall_3">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.1 0.4</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.2 1</ambient>
            <diffuse>0.6 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>1.0 -1.5 0.2 0 0 0.6</pose>
    </model>

    <!-- ==================== TRANSPORT OBJECT (pushable) ==================== -->
    <!-- This object has physics enabled so robots can push it -->
    <model name="transport_object">
      <link name="link">
        <velocity_decay>
          <linear>0.002</linear>
          <angular>0.005</angular>
        </velocity_decay>
        <inertial>
          <!-- Keep the practice crate light enough for one Burger to start
               with steady wheel force; larger fleets still share the load. -->
          <mass>0.25</mass>
          <inertia>
            <ixx>0.004167</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.004167</iyy><iyz>0</iyz>
            <izz>0.006667</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.2</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <!-- Low floor friction prevents impact-driven stick-slip at
                     the first contact while preserving a visible payload. -->
                <mu>0.05</mu>
                <mu2>0.05</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <max_vel>0.02</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.2</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-3.0 -3.0 0.1 0 0 0</pose>
    </model>

    <!-- ==================== TARGET MARKER (visual only) ==================== -->
    <model name="target_marker">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.1 0.1 0.8</ambient>
            <diffuse>0.9 0.1 0.1 0.8</diffuse>
          </material>
        </visual>
      </link>
      <pose>3.0 3.0 0.005 0 0 0</pose>
    </model>

    <!-- Camera position for nice default view -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -12 10 0 0.7 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
