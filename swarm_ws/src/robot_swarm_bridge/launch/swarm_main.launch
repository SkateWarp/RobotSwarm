<?xml version="1.0"?>
<launch>
  <!-- ================================================================= -->
  <!-- SWARM MAIN LAUNCH: Gazebo + Arena + Robot Fleet + Core Nodes      -->
  <!-- This is the base launch file included by all behavior launches    -->
  <!-- ================================================================= -->

  <!-- Arguments -->
  <arg name="robot_count" default="5"/>
  <arg name="robot_model" default="burger"/>
  <arg name="max_robots" default="0"/>
  <arg name="world_file" default="swarm_arena"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="spawn_pattern" default="grid"/>
  <arg name="spawn_spacing" default="1.0"/>
  <arg name="gazebo_wheel_acceleration" default="0.75"/>
  <arg name="gazebo_clock_frequency" default="100"/>
  <arg name="publish_robot_tf" default="false"/>
  <arg name="obstacle_density" default="none"/>
  <arg name="paused" default="false"/>
  <arg name="start_legacy_bridge" default="true"/>
  <arg name="control_watchdog_enabled" default="true"/>
  <arg name="control_heartbeat_timeout" default="10.0"/>
  <arg name="control_heartbeat_max_future" default="15.0"/>
  <arg name="control_watchdog_startup_grace" default="15.0"/>
  <arg name="control_watchdog_check_period" default="0.5"/>

  <!-- Set TurtleBot3 model environment variable -->
  <env name="TURTLEBOT3_MODEL" value="$(arg robot_model)"/>

  <!-- ==================== GAZEBO ==================== -->
  <!-- Keep /clock useful without publishing it at the full physics rate. -->
  <param name="/gazebo/pub_clock_frequency" type="double"
         value="$(arg gazebo_clock_frequency)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find robot_swarm_bridge)/worlds/$(arg world_file).world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="debug" value="false"/>
    <arg name="verbose" value="false"/>
  </include>

  <!-- ==================== CORE NODES ==================== -->
  <!-- The fleet manager is the sole spawner for every fleet size. -->
  <node pkg="robot_swarm_bridge" type="fleet_manager.py" name="fleet_manager" output="screen">
    <rosparam command="load" file="$(find robot_swarm_bridge)/config/arena_spawn_zones.yaml"/>
    <param name="robot_count" value="$(arg robot_count)"/>
    <param name="robot_model" value="$(arg robot_model)"/>
    <param name="max_robots" value="$(arg max_robots)"/>
    <param name="arena_profile" value="$(arg world_file)"/>
    <param name="spawn_pattern" value="$(arg spawn_pattern)"/>
    <param name="spawn_spacing" value="$(arg spawn_spacing)"/>
    <param name="gazebo_wheel_acceleration" value="$(arg gazebo_wheel_acceleration)"/>
    <param name="publish_robot_tf" type="bool" value="$(arg publish_robot_tf)"/>
    <param name="auto_spawn" value="true"/>
  </node>

  <!-- Task orchestrator (command routing and status) -->
  <node pkg="robot_swarm_bridge" type="task_orchestrator.py" name="task_orchestrator" output="screen">
    <param name="control_watchdog_enabled" value="$(arg control_watchdog_enabled)"/>
    <param name="control_heartbeat_timeout" value="$(arg control_heartbeat_timeout)"/>
    <param name="control_heartbeat_max_future" value="$(arg control_heartbeat_max_future)"/>
    <param name="control_watchdog_startup_grace" value="$(arg control_watchdog_startup_grace)"/>
    <param name="control_watchdog_check_period" value="$(arg control_watchdog_check_period)"/>
  </node>

  <!-- Obstacle generator (provides /environment/spawn_obstacles service) -->
  <node pkg="robot_swarm_bridge" type="obstacle_generator.py" name="obstacle_generator" output="screen"/>

  <!-- Spawn initial obstacles if requested -->
  <node if="$(eval arg('obstacle_density') != 'none')"
        pkg="rostopic" type="rostopic" name="spawn_obstacles_trigger"
        args="pub -1 /environment/spawn_obstacles_cmd std_msgs/String 'data: $(arg obstacle_density)'"
        launch-prefix="bash -c 'sleep 10; $0 $@'"/>

  <!-- ==================== BEHAVIOR NODES (idle until triggered) ==================== -->
  <!-- All three run simultaneously; each waits for its /start topic from task_orchestrator -->
  <node pkg="robot_swarm_bridge" type="follow_leader.py" name="follow_leader"
        output="screen">
    <rosparam command="load" file="$(find robot_swarm_bridge)/config/arena_spawn_zones.yaml"/>
    <param name="robot_count" value="$(arg robot_count)"/>
    <param name="arena_profile" value="$(arg world_file)"/>
  </node>

  <node pkg="robot_swarm_bridge" type="formation_control.py" name="formation_control"
        output="screen">
    <rosparam command="load" file="$(find robot_swarm_bridge)/config/arena_spawn_zones.yaml"/>
    <param name="robot_count" value="$(arg robot_count)"/>
    <param name="arena_profile" value="$(arg world_file)"/>
  </node>

  <node pkg="robot_swarm_bridge" type="collaborative_transport.py" name="collaborative_transport"
        output="screen">
    <rosparam command="load" file="$(find robot_swarm_bridge)/config/arena_spawn_zones.yaml"/>
    <param name="robot_count" value="$(arg robot_count)"/>
    <param name="arena_profile" value="$(arg world_file)"/>
  </node>

  <!-- ==================== SIGNALR BRIDGE ==================== -->
  <!-- Connects ROS topics to .NET backend via SignalR -->
  <arg name="backend_url" default="ws://localhost:44336/hubs/robot"/>
  <node if="$(arg start_legacy_bridge)"
        pkg="robot_swarm_bridge" type="bridge.py" name="signalr_bridge"
        output="screen" launch-prefix="bash -c 'sleep 20; $0 $@'">
    <param name="backend_url" value="$(arg backend_url)"/>
    <param name="robot_ids" value="[]"/>
  </node>

  <!-- ==================== RVIZ (optional) ==================== -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find robot_swarm_bridge)/rviz/swarm.rviz"/>

</launch>
