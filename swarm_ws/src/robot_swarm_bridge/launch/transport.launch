<?xml version="1.0"?>
<launch>
  <!-- ================================================================= -->
  <!-- COLLABORATIVE TRANSPORT: GRF-based multi-robot object pushing     -->
  <!-- Usage: roslaunch robot_swarm_bridge transport.launch               -->
  <!--        robot_count:=4 target_x:=3.0 target_y:=3.0                -->
  <!-- ================================================================= -->

  <!-- Behavior parameters -->
  <arg name="robot_count" default="4"/>
  <arg name="object_name" default="transport_object"/>
  <arg name="target_x" default="3.0"/>
  <arg name="target_y" default="3.0"/>
  <arg name="vmax" default="0.15"/>
  <arg name="sensing_range" default="2.0"/>
  <arg name="arrival_tolerance" default="0.5"/>
  <arg name="obstacle_density" default="none"/>

  <!-- Gazebo parameters -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="false"/>

  <!-- Parameters are addressed to the controller launched by swarm_main. -->
  <param name="/collaborative_transport/object_name" value="$(arg object_name)"/>
  <param name="/collaborative_transport/target_x" value="$(arg target_x)"/>
  <param name="/collaborative_transport/target_y" value="$(arg target_y)"/>
  <param name="/collaborative_transport/vmax" value="$(arg vmax)"/>
  <param name="/collaborative_transport/sensing_range" value="$(arg sensing_range)"/>
  <param name="/collaborative_transport/arrival_tolerance" value="$(arg arrival_tolerance)"/>

  <!-- Include main swarm (arena already has transport_object and target_marker) -->
  <include file="$(find robot_swarm_bridge)/launch/swarm_main.launch">
    <arg name="robot_count" value="$(arg robot_count)"/>
    <arg name="obstacle_density" value="$(arg obstacle_density)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>

</launch>
