<?xml version="1.0"?>
<launch>
  <!-- ================================================================= -->
  <!-- FOLLOW THE LEADER: Leader-follower chain behavior                 -->
  <!-- Usage: roslaunch robot_swarm_bridge follow_leader.launch           -->
  <!--        robot_count:=5 leader_mode:=circular                       -->
  <!-- ================================================================= -->

  <!-- Behavior parameters -->
  <arg name="robot_count" default="5"/>
  <arg name="leader_mode" default="circular"/>  <!-- circular, square, figure8, waypoint, manual -->
  <arg name="follow_distance" default="0.7"/>
  <arg name="time_delay" default="1.0"/>
  <arg name="max_linear_vel" default="0.2"/>
  <arg name="max_angular_vel" default="1.5"/>
  <arg name="path_radius" default="2.0"/>
  <arg name="obstacle_density" default="none"/>

  <!-- Gazebo parameters -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="false"/>

  <!-- Include main swarm (Gazebo + robots + core nodes) -->
  <include file="$(find robot_swarm_bridge)/launch/swarm_main.launch">
    <arg name="robot_count" value="$(arg robot_count)"/>
    <arg name="obstacle_density" value="$(arg obstacle_density)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>

  <!-- Follow-the-Leader Controller -->
  <node pkg="robot_swarm_bridge" type="follow_leader.py" name="follow_leader"
        output="screen" launch-prefix="bash -c 'sleep 15; $0 $@'">
    <param name="robot_count" value="$(arg robot_count)"/>
    <param name="leader_mode" value="$(arg leader_mode)"/>
    <param name="follow_distance" value="$(arg follow_distance)"/>
    <param name="time_delay" value="$(arg time_delay)"/>
    <param name="max_linear_vel" value="$(arg max_linear_vel)"/>
    <param name="max_angular_vel" value="$(arg max_angular_vel)"/>
    <param name="path_radius" value="$(arg path_radius)"/>
  </node>

</launch>
